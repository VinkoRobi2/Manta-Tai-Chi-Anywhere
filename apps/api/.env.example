NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://manta:manta@localhost:5433/manta?schema=public
# Orígenes permitidos para el navegador (la web en local corre en el 3001)
CORS_ORIGINS=http://localhost:3001

# RevenueCat: en el dashboard, Integrations > Webhooks > Authorization header = "Bearer <este secreto>"
REVENUECAT_WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo
REVENUECAT_ENTITLEMENT_ID=premium

# Cloudflare R2 (contenido de las clases). Vacío en local: se usa CONTENT_DEV_BASE_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=manta-content
CONTENT_DEV_BASE_URL=http://localhost:8787
SIGNED_URL_TTL_SECONDS=300
