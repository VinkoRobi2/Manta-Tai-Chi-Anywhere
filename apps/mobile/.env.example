# Dirección de la API. En desarrollo puede quedar vacía: la app usa tu computadora (la de Expo) en el puerto 3000.
EXPO_PUBLIC_API_URL=

# Entrar con Google (Google Cloud > APIs y servicios > Credenciales > IDs de cliente de OAuth).
# "Web client ID": el mismo que GOOGLE_CLIENT_IDS en apps/api/.env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# "iOS client ID". También añade el plugin de Google al compilar la app instalada (ver app.config.ts).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Métricas de uso en PostHog (Settings > Project > Project API key, empieza por "phc_"). Es pública.
# Vacía, la app no manda nada.
EXPO_PUBLIC_POSTHOG_KEY=
