      "captions": [
        {
          "atMs": 0,
          "text": "As you breathe in, float your arms up in front to shoulder height, as if the water were holding them."
        },
        {
          "atMs": 18000,
          "text": "As you breathe out, your hands sink to your thighs."
        },
        {
          "atMs": 36000,
          "text": "Soft elbows, loose wrists."
        },
        {
          "atMs": 54000,
          "text": "Only rise as far as feels comfortable."
        }
