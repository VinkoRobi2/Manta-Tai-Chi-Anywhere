      "captions": [
        {
          "atMs": 0,
          "text": "Siéntate cerca del borde de la silla, con los pies firmes en el suelo y la espalda larga."
        },
        {
          "atMs": 18000,
          "text": "Deja caer los hombros."
        },
        {
          "atMs": 36000,
          "text": "El aire entra por la nariz, despacio."
        },
        {
          "atMs": 54000,
          "text": "Suelta la mandíbula y la frente."
        }
