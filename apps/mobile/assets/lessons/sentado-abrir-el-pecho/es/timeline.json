      "mirrorable": true,
      "captions": [
        {
          "atMs": 0,
          "text": "Las manos se juntan frente al pecho. Al inhalar, se abren despacio hacia los lados."
        },
        {
          "atMs": 18000,
          "text": "Al exhalar, vuelven a juntarse."
        },
        {
          "atMs": 36000,
          "text": "Siente cómo se ensancha el pecho."
        },
        {
          "atMs": 54000,
