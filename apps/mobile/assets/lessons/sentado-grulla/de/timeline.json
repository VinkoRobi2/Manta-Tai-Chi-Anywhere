      "captions": [
        {
          "atMs": 0,
          "text": "Setz dich nah an die Stuhlkante, die Füße fest am Boden, der Rücken lang."
        },
        {
          "atMs": 18000,
          "text": "Lass die Schultern sinken."
        },
        {
          "atMs": 36000,
          "text": "Atme langsam durch die Nase ein."
        },
        {
          "atMs": 54000,
          "text": "Lockere Kiefer und Stirn."
